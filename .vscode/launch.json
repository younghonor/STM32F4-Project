{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "jlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch JLink GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/build/Debug/Stm32CubeMX-FreeRTOS-Hal.elf",

            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ],
            "serverDevice": "STM32F407IE",
            "serverInterface": "SWD",
            "serverSpeed": "4000",
            "serverPort": "2331",
            "serverSingleRun": true,
            "runEntry": "main",
            "initCommands": [
                "monitor halt",
                "monitor reset",
                "load",
                "monitor reset"
            ],

        },
    ]
}